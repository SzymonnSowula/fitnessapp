<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="12dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            app:tint="#004A99"
            android:scaleType="fitCenter"
            android:padding="12dp"
            android:contentDescription="@string/back_desc" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/game_2048"
            android:textColor="#004A99"
            android:textSize="44sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#DBEAFE">
            <TextView
                android:id="@+id/tv_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/game_2048_score"
                android:textColor="#1E40AF"
                android:textSize="32sp"
                android:textStyle="bold" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_instruction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/game_2048_instruction"
        android:textColor="#475569"
        android:textSize="26sp"
        android:fontFamily="sans-serif-medium" />

    <TableLayout
        android:id="@+id/grid_table"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="16dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/light_gray_bg"
        android:padding="6dp"
        android:shrinkColumns="*"
        android:stretchColumns="*">

        <TableRow android:layout_weight="1">
            <TextView android:id="@+id/cell_00" style="@style/GameCell" />
            <TextView android:id="@+id/cell_01" style="@style/GameCell" />
            <TextView android:id="@+id/cell_02" style="@style/GameCell" />
            <TextView android:id="@+id/cell_03" style="@style/GameCell" />
        </TableRow>
        <TableRow android:layout_weight="1">
            <TextView android:id="@+id/cell_10" style="@style/GameCell" />
            <TextView android:id="@+id/cell_11" style="@style/GameCell" />
            <TextView android:id="@+id/cell_12" style="@style/GameCell" />
            <TextView android:id="@+id/cell_13" style="@style/GameCell" />
        </TableRow>
        <TableRow android:layout_weight="1">
            <TextView android:id="@+id/cell_20" style="@style/GameCell" />
            <TextView android:id="@+id/cell_21" style="@style/GameCell" />
            <TextView android:id="@+id/cell_22" style="@style/GameCell" />
            <TextView android:id="@+id/cell_23" style="@style/GameCell" />
        </TableRow>
        <TableRow android:layout_weight="1">
            <TextView android:id="@+id/cell_30" style="@style/GameCell" />
            <TextView android:id="@+id/cell_31" style="@style/GameCell" />
            <TextView android:id="@+id/cell_32" style="@style/GameCell" />
            <TextView android:id="@+id/cell_33" style="@style/GameCell" />
        </TableRow>
    </TableLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btn_up"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:maxWidth="80dp"
            android:layout_marginHorizontal="8dp"
            android:text="@string/game_2048_up"
            android:textSize="28sp"
            android:backgroundTint="@color/light_blue_bg"
            android:textColor="@color/blue_primary" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btn_left"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:maxWidth="80dp"
            android:layout_marginHorizontal="8dp"
            android:text="@string/game_2048_left"
            android:textSize="28sp"
            android:backgroundTint="@color/light_blue_bg"
            android:textColor="@color/blue_primary" />

        <Button
            android:id="@+id/btn_down"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:maxWidth="80dp"
            android:layout_marginHorizontal="8dp"
            android:text="@string/game_2048_down"
            android:textSize="28sp"
            android:backgroundTint="@color/light_blue_bg"
            android:textColor="@color/blue_primary" />

        <Button
            android:id="@+id/btn_right"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:maxWidth="80dp"
            android:layout_marginHorizontal="8dp"
            android:text="@string/game_2048_right"
            android:textSize="28sp"
            android:backgroundTint="@color/light_blue_bg"
            android:textColor="@color/blue_primary" />

    </LinearLayout>

    <Button
        android:id="@+id/btn_restart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#004A99"
        android:text="@string/game_2048_restart"
        android:textColor="@color/white"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        app:cornerRadius="16dp" />

</LinearLayout>