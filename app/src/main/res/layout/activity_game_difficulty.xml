<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- Top Navigation (Back button might be needed but not in screenshot, I'll keep it small or remove if strictly 1:1) -->
    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_back"
        app:tint="#004A99"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Wybierz poziom\ntrudności"
            android:textColor="#004A99"
            android:textSize="40sp"
            android:textStyle="bold"
            android:lineSpacingExtra="4dp" />

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Wybierz jak bardzo chcesz\npoćwiczyć"
            android:textColor="#64748B"
            android:textSize="22sp"
            android:lineSpacingExtra="4dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Easy Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_easy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/white">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <FrameLayout
                    android:id="@+id/icon_container_easy"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/bg_indicator_active"
                    android:backgroundTint="#E6F9EE">
                    <ImageView
                        android:id="@+id/iv_easy_icon"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_leaf"
                        app:tint="#10B981" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/icon_container_easy"
                    android:layout_marginStart="20dp"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tv_easy_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Łatwy"
                        android:textColor="#004A99"
                        android:textSize="32sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tv_easy_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Delikatny ruch, bez pośpiechu"
                        android:textColor="#64748B"
                        android:textSize="18sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/iv_check_easy"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_check_circle"
                    app:tint="@color/white"
                    android:visibility="gone" />
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <!-- Medium Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#004A99">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <FrameLayout
                    android:id="@+id/icon_container_medium"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/bg_indicator_active"
                    android:backgroundTint="#337ACC">
                    <ImageView
                        android:id="@+id/iv_medium_icon"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_dumbbell"
                        app:tint="@color/white" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/icon_container_medium"
                    android:layout_marginStart="20dp"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tv_medium_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Średni"
                        android:textColor="@color/white"
                        android:textSize="32sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tv_medium_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Standardowe tempo i ćwiczenia"
                        android:textColor="#DBEAFE"
                        android:textSize="18sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/iv_check_medium"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_check_circle"
                    app:tint="@color/white"
                    android:visibility="visible" />
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <!-- Hard Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_hard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/white">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <FrameLayout
                    android:id="@+id/icon_container_hard"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/bg_indicator_active"
                    android:backgroundTint="#FEF2F2">
                    <ImageView
                        android:id="@+id/iv_hard_icon"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_lightning"
                        app:tint="#EF4444" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/icon_container_hard"
                    android:layout_marginStart="20dp"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tv_hard_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Trudny"
                        android:textColor="#004A99"
                        android:textSize="32sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tv_hard_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dla osób szukających wyzwań"
                        android:textColor="#64748B"
                        android:textSize="18sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/iv_check_hard"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_check_circle"
                    app:tint="@color/white"
                    android:visibility="gone" />
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Next Button -->
        <Button
            android:id="@+id/btn_start"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:backgroundTint="#0056B3"
            android:text="Dalej"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_chevron_right"
            app:iconGravity="textEnd"
            app:iconTint="@color/white"
            app:iconPadding="8dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
