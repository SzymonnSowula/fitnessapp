<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:paddingHorizontal="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="16dp">

    <!-- Header Progress Area -->
    <LinearLayout
        android:id="@+id/header_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="ĆWICZENIE 1 Z 5"
                android:textColor="#1E293B"
                android:textSize="26sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <ImageButton
                android:id="@+id/btn_help"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_alignParentEnd="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_help"
                android:scaleType="fitCenter"
                android:padding="8dp"
                android:contentDescription="@string/voice_help_desc" />

            <TextView
                android:id="@+id/tv_percentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@id/btn_help"
                android:layout_centerVertical="true"
                android:layout_marginEnd="16dp"
                tools:text="20%"
                android:textColor="#004A99"
                android:textSize="26sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <ProgressBar
            android:id="@+id/progress_exercise"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="8dp"
            android:max="100"
            tools:progress="20"
            android:progressDrawable="@drawable/progress_bar_custom" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_difficulty_icons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#004A99"
                android:textSize="24sp"
                tools:text="● ● ○" />

            <TextView
                android:id="@+id/tv_difficulty_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="#64748B"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="Średnie" />
        </LinearLayout>
    </LinearLayout>

    <!-- Step 1: Description -->
    <LinearLayout
        android:id="@+id/layout_step1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:orientation="vertical"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@id/btn_next"
        app:layout_constraintTop_toBottomOf="@id/header_progress">

        <TextView
            android:id="@+id/tv_exercise_name_step1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Nazwa Ćwiczenia"
            android:textColor="#004A99"
            android:textSize="44sp"
            android:textStyle="bold"
            android:lineSpacingMultiplier="0.9" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/instruction_label"
            android:textColor="#334155"
            android:textSize="28sp"
            android:textStyle="bold" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:fillViewport="true">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp">

                <TextView
                    android:id="@+id/tv_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp"
                    android:textColor="#1E293B"
                    android:textSize="32sp"
                    android:lineSpacingMultiplier="1.1"
                    tools:text="Tutaj pojawi się opis ćwiczenia, który jest duży i czytelny dla seniora." />
            </androidx.cardview.widget.CardView>
        </ScrollView>
    </LinearLayout>

    <!-- Step 2: Video & Contraindications -->
    <ScrollView
        android:id="@+id/layout_step2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/btn_next"
        app:layout_constraintTop_toBottomOf="@id/header_progress">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_exercise_name_step2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Nazwa Ćwiczenia"
                android:textColor="#004A99"
                android:textSize="44sp"
                android:textStyle="bold"
                android:lineSpacingMultiplier="0.9" />

            <androidx.cardview.widget.CardView
                android:id="@+id/video_container"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="#000000">

                <VideoView
                    android:id="@+id/video_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tv_contraindications_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/contraindications_label"
                android:textColor="#B91C1C"
                android:textSize="26sp"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_contraindications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#FEF2F2"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/tv_contraindications"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:textColor="#B91C1C"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    tools:text="Choroba stawów kolan/bioder" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_next"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#005CB9"
        tools:text="DALEJ"
        android:textAllCaps="true"
        android:textColor="@color/white"
        android:textSize="28sp"
        android:textStyle="bold"
        app:cornerRadius="20dp"
        app:layout_constraintBottom_toTopOf="@id/btn_finish" />

    <Button
        android:id="@+id/btn_finish"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:backgroundTint="#FFFFFF"
        tools:text="POPRZEDNIE"
        android:textAllCaps="true"
        android:textColor="#1E293B"
        android:textSize="28sp"
        android:textStyle="bold"
        app:strokeColor="#CBD5E1"
        app:strokeWidth="2dp"
        app:cornerRadius="20dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>