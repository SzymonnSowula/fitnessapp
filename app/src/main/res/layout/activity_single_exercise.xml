<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="16dp">

    <!-- Header Progress Area -->
    <LinearLayout
        android:id="@+id/header_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent">

<RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ĆWICZENIE 1 Z 5"
            android:textColor="#1E293B"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <ImageButton
            android:id="@+id/btn_help"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_alignParentEnd="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_help"
            android:scaleType="fitCenter"
            android:padding="8dp"
            android:contentDescription="Pomoc głosowa" />

        <TextView
            android:id="@+id/tv_percentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@id/btn_help"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp"
            android:text="20%"
            android:textColor="#004A99"
            android:textSize="26sp"
            android:textStyle="bold" />
    </RelativeLayout>

        <ProgressBar
            android:id="@+id/progress_exercise"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="20"
            android:progressDrawable="@drawable/progress_bar_custom" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/btn_next"
        app:layout_constraintTop_toBottomOf="@id/header_progress">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_exercise_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Wykrok w tył z asekuracją krzesła"
                android:textColor="#004A99"
                android:textSize="44sp"
                android:textStyle="bold"
                android:lineSpacingMultiplier="0.9" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_difficulty_icons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⤢ ⤢ ⤢ ⤢ ⤢"
                    android:textColor="#057A32"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/tv_difficulty_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Łatwe"
                    android:textColor="#057A32"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="#F1F5F9"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/tv_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp"
                    android:text="Stań stabilnie przy oparciu krzesła. Wykonaj spokojny krok w tył, uginając lekko kolana. Trzymaj plecy prosto i wspomagaj się dłońmi na krześle dla pełnego bezpieczeństwa. Powoli wróć do pozycji wyjściowej."
                    android:textColor="#1E293B"
                    android:textSize="26sp"
                    android:lineSpacingMultiplier="1.1" />
            </androidx.cardview.widget.CardView>

            <!-- Video Mockup Container -->
            <androidx.cardview.widget.CardView
                android:id="@+id/video_mockup_container"
                android:layout_width="match_parent"
                android:layout_height="400dp"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#000000">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Mock image representing video content -->
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/bg_card_onboarding"
                        android:alpha="0.6"/>

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_centerInParent="true"
                        android:src="@android:drawable/ic_media_play"
                        android:contentDescription="Odtwórz"
                        app:tint="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_alignParentStart="true"
                        android:layout_margin="20dp"
                        android:text="Odtwórz instruktaż wideo"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_indicator_inactive"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:alpha="0.8"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_alignParentEnd="true"
                        android:layout_margin="20dp"
                        android:text="0:45"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tv_contraindications_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="PRZECIWWSKAZANIA"
                android:textColor="#B91C1C"
                android:textSize="26sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_contraindications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:textColor="#B91C1C"
                android:textSize="26sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_next"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#005CB9"
        android:text="NASTĘPNE ĆWICZENIE"
        android:textAllCaps="true"
        android:textColor="@color/white"
        android:textSize="26sp"
        android:textStyle="bold"
        app:icon="@drawable/ic_chevron_right"
        app:iconGravity="textEnd"
        app:iconPadding="16dp"
        app:iconTint="@color/white"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toTopOf="@id/btn_finish" />

    <Button
        android:id="@+id/btn_finish"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:backgroundTint="#FFFFFF"
        android:text="Zakończ"
        android:textAllCaps="false"
        android:textColor="#1E293B"
        android:textSize="26sp"
        android:textStyle="bold"
        app:strokeColor="#CBD5E1"
        app:strokeWidth="2dp"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>