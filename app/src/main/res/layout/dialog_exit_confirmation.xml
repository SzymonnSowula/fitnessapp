<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="32dp"
    android:background="@drawable/dialog_background"
    android:gravity="center">

    <TextView
        android:id="@+id/tv_exit_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Wyjście z aplikacji"
        android:textColor="#004A99"
        android:textSize="32sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/tv_exit_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Czy na pewno chcesz wyjść z aplikacji?"
        android:textColor="#1E293B"
        android:textSize="24sp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.2" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:orientation="horizontal"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_exit_confirm"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:text="Tak, wyjdź"
            android:textSize="20sp"
            android:backgroundTint="#057A32" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_exit_cancel"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Nie, zostaję"
            android:textSize="20sp"
            android:backgroundTint="#004A99" />

    </LinearLayout>

</LinearLayout>
