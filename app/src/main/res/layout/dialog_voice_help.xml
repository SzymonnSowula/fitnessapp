<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="40dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/vh_title"
        android:textColor="#1E293B"
        android:textSize="40sp"
        android:textStyle="bold"
        android:gravity="center"
        android:lineSpacingMultiplier="1.5"
        android:letterSpacing="0.05" />

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginVertical="16dp"
        android:background="#E2E8F0" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="500dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vh_navigation_title"
                android:textColor="#1E293B"
                android:textSize="32sp"
                android:textStyle="bold"
                android:lineSpacingMultiplier="1.5"
                android:layout_marginTop="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/vh_navigation_desc"
                android:textColor="#1E293B"
                android:textSize="26sp"
                android:textStyle="bold"
                android:lineSpacingMultiplier="1.5"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vh_general_title"
                android:textColor="#1E293B"
                android:textSize="32sp"
                android:textStyle="bold"
                android:lineSpacingMultiplier="1.5"
                android:layout_marginTop="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/vh_general_desc"
                android:textColor="#1E293B"
                android:textSize="26sp"
                android:textStyle="bold"
                android:lineSpacingMultiplier="1.5"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vh_exercises_title"
                android:textColor="#1E293B"
                android:textSize="32sp"
                android:textStyle="bold"
                android:lineSpacingMultiplier="1.5"
                android:layout_marginTop="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/vh_exercises_desc"
                android:textColor="#1E293B"
                android:textSize="26sp"
                android:textStyle="bold"
                android:lineSpacingMultiplier="1.5"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vh_games_title"
                android:textColor="#1E293B"
                android:textSize="32sp"
                android:textStyle="bold"
                android:lineSpacingMultiplier="1.5"
                android:layout_marginTop="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/vh_games_desc"
                android:textColor="#1E293B"
                android:textSize="26sp"
                android:textStyle="bold"
                android:lineSpacingMultiplier="1.5"
                android:layout_marginTop="8dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>