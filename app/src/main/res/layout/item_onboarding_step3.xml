<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"
        android:text="@string/onboarding_step_3_title"
        android:textColor="@color/black"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/onboarding_intensity_label"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rg_intensity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">

        <RadioButton
            android:id="@+id/rb_intensity_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/onboarding_intensity_1" />

        <RadioButton
            android:id="@+id/rb_intensity_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_intensity_2" />
    </RadioGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/onboarding_difficulty_label"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rg_difficulty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/rb_difficulty_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/onboarding_difficulty_1" />

        <RadioButton
            android:id="@+id/rb_difficulty_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_difficulty_2" />
    </RadioGroup>

</LinearLayout>