<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_nav_container"
    android:layout_width="match_parent"
    android:layout_height="210dp"
    app:cardCornerRadius="50dp"
    app:cardElevation="16dp"
    app:cardBackgroundColor="#FFFFFF"
    android:layout_marginBottom="-35dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:paddingBottom="35dp"
        android:paddingHorizontal="4dp"
        android:gravity="bottom">

        <!-- Home Tab (ChoiceActivity) -->
        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <androidx.cardview.widget.CardView
                android:id="@+id/nav_home_indicator"
                android:layout_width="120dp"
                android:layout_height="85dp"
                app:cardCornerRadius="30dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@android:color/transparent">
                <ImageView
                    android:id="@+id/nav_home_icon"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_home"
                    app:tint="#64748B" />
            </androidx.cardview.widget.CardView>
            <TextView
                android:id="@+id/nav_home_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_home"
                android:textColor="#64748B"
                android:textStyle="bold"
                android:textSize="24sp"
                android:maxLines="1"
                android:ellipsize="none"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Exercises Tab (MainActivity) -->
        <LinearLayout
            android:id="@+id/nav_plan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <androidx.cardview.widget.CardView
                android:id="@+id/nav_plan_indicator"
                android:layout_width="120dp"
                android:layout_height="85dp"
                app:cardCornerRadius="30dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@android:color/transparent">
                <ImageView
                    android:id="@+id/nav_plan_icon"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_dumbbell"
                    app:tint="#64748B" />
            </androidx.cardview.widget.CardView>
            <TextView
                android:id="@+id/nav_plan_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_exercises"
                android:textColor="#64748B"
                android:textStyle="bold"
                android:textSize="24sp"
                android:maxLines="1"
                android:ellipsize="none"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Settings Tab -->
        <LinearLayout
            android:id="@+id/nav_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <androidx.cardview.widget.CardView
                android:id="@+id/nav_settings_indicator"
                android:layout_width="120dp"
                android:layout_height="85dp"
                app:cardCornerRadius="30dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@android:color/transparent">
                <ImageView
                    android:id="@+id/nav_settings_icon"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_settings"
                    app:tint="#64748B" />
            </androidx.cardview.widget.CardView>
            <TextView
                android:id="@+id/nav_settings_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_settings_label"
                android:textColor="#64748B"
                android:textStyle="bold"
                android:textSize="24sp"
                android:maxLines="1"
                android:ellipsize="none"
                android:layout_marginTop="4dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>